	measure 'Preço Unitário Mínimo' =
			
			CALCULATE(
			    MIN('BPS_20_26_Petras_Ruben_Carvalho'[Preço Unitário]),
			    'BPS_20_26_Petras_Ruben_Carvalho'[Preço Unitário] > 0
			)
		formatString: "R$"\ #,0.0000;-"R$"\ #,0.0000;"R$"\ #,0.0000
