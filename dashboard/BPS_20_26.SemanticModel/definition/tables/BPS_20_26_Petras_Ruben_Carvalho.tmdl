		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Preço Unitário Máximo' =
			
			MAX(
			    'BPS_20_26_Petras_Ruben_Carvalho'[Preço Unitário]
			)
		formatString: "R$"\ #,0.0000;-"R$"\ #,0.0000;"R$"\ #,0.0000
		lineageTag: 841b0580-ff53-4eb6-819d-41aef846b8aa

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Variação de Preço' =
			
			[Preço Unitário Máximo] - [Preço Unitário Mínimo]
